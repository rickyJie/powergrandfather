<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- PGF Connector palette (light) — mirrors the reference project
         powergrandfather-responsive/android-connector for a coherent
         "business connector" look. Dark counterparts live in values-night. -->

    <color name="pgf_primary">#2952CC</color>
    <color name="pgf_primary_dark">#17388F</color>
    <color name="pgf_accent">#0E8A65</color>
    <color name="pgf_surface">#F5F7FB</color>
    <color name="pgf_surface_elevated">#FFFFFF</color>
    <color name="pgf_stroke">#D8DEEA</color>
    <color name="pgf_text">#172033</color>
    <color name="pgf_text_muted">#667085</color>
    <color name="pgf_status_bg">#E8EDF9</color>
