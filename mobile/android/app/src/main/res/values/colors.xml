    <color name="status_connecting">#B58003</color>
    <color name="status_connected">#0E8A65</color>
    <color name="status_error">#B3261E</color>
    <color name="status_idle">#8B8B8B</color>

    <!-- Legacy aliases still referenced by drawables -->
    <color name="csm_blue">@color/pgf_primary</color>
    <color name="csm_blue_dark">@color/pgf_primary_dark</color>
    <color name="csm_bg">@color/pgf_surface</color>
