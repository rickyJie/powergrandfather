    <color name="md_on_primary">#FFFFFF</color>
    <color name="md_primary_container">#DDE5F8</color>
    <color name="md_on_primary_container">#0B1E52</color>
    <color name="md_secondary">@color/pgf_accent</color>
    <color name="md_on_secondary">#FFFFFF</color>
    <color name="md_secondary_container">#C8ECDA</color>
    <color name="md_on_secondary_container">#08321F</color>
    <color name="md_tertiary">@color/pgf_primary</color>
    <color name="md_on_tertiary">#FFFFFF</color>
    <color name="md_tertiary_container">#DDE5F8</color>
    <color name="md_on_tertiary_container">#0B1E52</color>
    <color name="md_error">#B3261E</color>
    <color name="md_on_error">#FFFFFF</color>
    <color name="md_background">@color/pgf_surface</color>
    <color name="md_on_background">@color/pgf_text</color>
    <color name="md_surface">@color/pgf_surface_elevated</color>
    <color name="md_surface_variant">#E8EDF9</color>
    <color name="md_on_surface">@color/pgf_text</color>
