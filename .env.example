# PowerGrandFather env overrides — copy to .env if you want to persist any of these.
# All keys use the CSM_ prefix; the settings model reads them via Pydantic.

# ---- database ----
# Path to the SQLite file. Absolute or CWD-relative.
# CSM_DB_PATH=csm.db

# ---- HTTP bind ----
# Default is 127.0.0.1 — the console answers only on this machine, and you
# reach it from elsewhere over an SSH tunnel. Setting 0.0.0.0 exposes it to
# the whole LAN, and there is no auth in front of it: POST /api/sessions can
# spawn processes. Only do that on a network you fully trust.
# CSM_HOST=127.0.0.1
# CSM_PORT=8000

# ---- Claude integration ----
# Where to tail JSONL usage / message files.
# CSM_CLAUDE_PROJECTS_DIR=~/.claude/projects

# argv override — replaces `claude` with something else when spawning
# sessions. Useful for tests: `bash -i` gives you a shell so tests don't
# burn real Claude tokens.
# CSM_CLAUDE_ARGV='bash -i'

# ---- workflow YAMLs ----
# Directory scanned by POST /api/workflows/reload.
# CSM_TASKS_DIR=tasks

# ---- event stream cadence ----
# CSM_EVENT_STREAM_POLL_INTERVAL_SEC=5.0
# CSM_EVENT_STREAM_WATCHDOG_INTERVAL_SEC=60.0
# CSM_SESSION_IDLE_MINUTES=30

# ---- notifications ----
# Notification dedup window; two events within this many seconds collapse
# into one row.
# CSM_NOTIF_DEDUP_WINDOW_SEC=5

# Optional Lark webhook — if set, notifications also POST here.
# CSM_LARK_WEBHOOK_URL=

# ---- token rollup ----
# CSM_ROLLUP_TICK_INTERVAL_SEC=3600.0
# CSM_RAW_TOKEN_EVENT_TTL_DAYS=0   # 0 = keep forever
